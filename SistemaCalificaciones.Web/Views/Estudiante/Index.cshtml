@model IEnumerable<EstudianteModel>
@{
    ViewData["Title"] = "Estudiantes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Estudiantes</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo estudiante</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (TempData["Contrasena"] is string contrasena)
{
    <div class="alert alert-warning">
        <strong>Acceso de @TempData["Usuario"]:</strong> contraseña temporal <code>@contrasena</code><br />
        Cópiala ahora y entrégala al alumno. No se volverá a mostrar.
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Buscar por matrícula o nombre" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">No hay estudiantes que mostrar.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Matrícula</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Estatus</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Matricula</td>
                    <td>@e.ApellidoPaterno @e.ApellidoMaterno, @e.Nombre</td>
                    <td>@e.Correo</td>
                    <td>
                        @if (e.Estatus)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form asp-action="RestablecerContrasena" asp-route-id="@e.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Generar una nueva contraseña temporal para @e.Matricula?');">
                            <button type="submit" class="btn btn-sm btn-outline-warning">Contraseña</button>
                        </form>
                        <form asp-action="CambiarEstatus" asp-route-id="@e.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                @(e.Estatus ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}