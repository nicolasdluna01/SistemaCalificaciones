@model IEnumerable<DocenteModel>
@{
    ViewData["Title"] = "Docentes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Docentes</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo docente</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay docentes registrados.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>No. empleado</th>
                <th>Nombre</th>
                <th>Usuario</th>
                <th>Correo</th>
                <th>Estatus</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.NumeroEmpleado</td>
                    <td>@d.ApellidoPaterno @d.ApellidoMaterno, @d.Nombre</td>
                    <td>@d.Usuario</td>
                    <td>@d.Correo</td>
                    <td>
                        @if (d.Estatus)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="RestablecerContrasena" asp-route-id="@d.Id" class="btn btn-sm btn-outline-warning">Contraseña</a>
                        <form asp-action="CambiarEstatus" asp-route-id="@d.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                @(d.Estatus ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}