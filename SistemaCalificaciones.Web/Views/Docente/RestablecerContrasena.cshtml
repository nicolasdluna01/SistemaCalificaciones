@model RestablecerContrasenaViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<h1 class="h3 mb-1">Restablecer contraseña</h1>
<p class="text-muted mb-3">@Model.NombreDocente</p>

<form asp-action="RestablecerContrasena" method="post" style="max-width: 480px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="NombreDocente" />

    <div class="mb-3">
        <label asp-for="NuevaContrasena" class="form-label"></label>
        <input asp-for="NuevaContrasena" class="form-control" autocomplete="new-password" />
        <div class="form-text">Mínimo 6 caracteres, con mayúscula, minúscula, número y símbolo.</div>
        <span asp-validation-for="NuevaContrasena" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Confirmar" class="form-label"></label>
        <input asp-for="Confirmar" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Confirmar" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Restablecer</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}